# Add validation for dangerous characters
# Check for path traversal attacks and special characters
def validate_file_id(file_id):  
    if not file_id:
        return False
    # Check for dangerous characters
    if any(char in file_id for char in ['..', '/', '\\', ':', '*', '?', '"', '<', '>', '|']):
        return False
    return True
# Validate user IP address
# Check if it's a valid IPv4 format
def validate_user_ip(user_ip):
    import re
    pattern = re.compile(r'^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$')
    if pattern.match(user_ip):
        return True
    return False    
